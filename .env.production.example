# Copy to .env.production on the server and replace every change_me value there.
# Do not commit the real .env.production file.

COMPOSE_PROJECT_NAME=fbkp
WEB_IMAGE_REPOSITORY=fbkp-web
WORKER_IMAGE_REPOSITORY=fbkp-worker
IMAGE_TAG=local

NODE_ENV=production
APP_BASE_URL=http://example.com
META_OAUTH_REDIRECT_URI=http://example.com/api/meta/oauth/callback

POSTGRES_DB=adflow
POSTGRES_USER=adflow
POSTGRES_PASSWORD=change_me_generate_a_long_random_database_password
DATABASE_URL=postgresql://adflow:change_me_generate_a_long_random_database_password@postgres:5432/adflow?schema=public

REDIS_PASSWORD=change_me_generate_a_long_random_redis_password
REDIS_URL=redis://:change_me_generate_a_long_random_redis_password@redis:6379/0

AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
TOKEN_ENCRYPTION_KEY=change_me_base64_encoded_32_random_bytes
TOKEN_ENCRYPTION_KEY_BASE64=change_me_base64_encoded_32_random_bytes

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
DEMO_MODE=false
META_DEMO_MODE=false
ENABLE_META_WRITES=false
EMERGENCY_READONLY=false
ALLOWED_META_AD_ACCOUNT_IDS=

LOG_LEVEL=info
EXPORT_URL_TTL_SECONDS=3600
AUDIT_RETENTION_DAYS=180

# deploy/healthcheck.sh uses this local URL by default.
HEALTHCHECK_URL=http://127.0.0.1/api/health/live
