{
  "name": "adflow-console",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx db/seed.ts",
    "dev": "pnpm --filter @adflow/web dev",
    "worker:dev": "pnpm --filter @adflow/worker dev",
    "worker:build": "pnpm --filter @adflow/worker build",
    "worker:start": "pnpm --filter @adflow/worker start",
    "worker:health": "pnpm --filter @adflow/worker health",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build",
    "e2e": "pnpm --filter @adflow/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/binding-win32-x64-msvc": "1.1.2",
    "@turbo/windows-64": "2.10.0",
    "eslint": "10.5.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prisma": "7.8.0",
    "turbo": "2.10.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  }
}
