{
  "name": "@adflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts src/health/read-heartbeat.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --outbase=src --sourcemap --external:bullmq --external:ioredis --external:pg --external:@prisma/*",
    "start": "node --enable-source-maps dist/index.js",
    "health": "tsx src/health/read-heartbeat.ts"
  },
  "dependencies": {
    "@adflow/db": "workspace:*",
    "@adflow/meta-client": "workspace:*",
    "@adflow/shared": "workspace:*",
    "bullmq": "^5.79.1",
    "ioredis": "5.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "esbuild": "0.28.1",
    "tsx": "4.22.4",
    "vitest": "4.1.9"
  }
}
